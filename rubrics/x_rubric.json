{"assignment_info": {"name": "midterm_exam", "title": "Midterm Exam - Comprehensive R Data Wrangling Assessment", "description": "Comprehensive assessment of Lessons 1-8: R basics, data cleaning, transformation, reshaping, joins, strings, dates, and advanced wrangling", "total_points": 100, "time_limit": "4 hours", "data_location": "data/processed/"}, "strict_scoring_enabled": true, "strict_scoring_rules": {"no_output_no_points": true, "template_only_max_percent": 0, "missing_section_zero": true, "wrong_output_max_credit": 50, "completion_based_maximum": true, "differentiation_required": true, "flexible_column_names": false, "accept_adaptations": false}, "data_structure": {"note": "Midterm uses 5 datasets for comprehensive assessment", "sales_data_columns": ["Region", "Product_Category", "Revenue", "Units_Sold", "Sale_Date"], "customers_columns": ["CustomerID", "CustomerName", "Email", "JoinDate"], "products_columns": ["ProductID", "ProductName", "Category", "Price"], "orders_columns": ["OrderID", "CustomerID", "OrderDate", "TotalAmount"], "order_items_columns": ["OrderItemID", "OrderID", "ProductID", "Quantity", "LineTotal"], "expected_rows": {"sales_data": 500, "customers": 100, "products": 50, "orders": 200, "order_items": 500}}, "rubric_elements": {"technical_execution": {"weight": 0.4, "max_points": 40, "description": "Code correctness, execution, and proper use of R functions", "criteria": ["All code cells executed with visible outputs", "Proper use of pipe operator (%>%) throughout", "Correct syntax for all tidyverse functions", "No critical errors that prevent analysis", "All required variables created with correct names", "Data imported successfully", "Working directory set appropriately"], "execution_requirements": {"cells_must_be_run": true, "description": "ALL code cells must be executed and show outputs", "penalty": "Each unexecuted cell = 2 points deduction", "note": "This is an exam - all work must be shown"}, "deductions": {"no_outputs": "Code without outputs = 0 points for that section", "unexecuted_cells": "Each cell without output = 2 points deduction", "syntax_errors": "Each critical syntax error = 5 points deduction", "template_only": "Only template code with TODOs = 0 points", "wrong_variable_names": "Each incorrect variable name = 1 point deduction"}}, "code_quality": {"weight": 0.2, "max_points": 20, "description": "Clean, well-commented, readable code following best practices", "criteria": ["Consistent use of pipe operator", "Meaningful variable names", "Comments explaining logic", "Proper indentation", "No unnecessary code duplication", "Efficient use of tidyverse functions"], "deductions": {"no_pipes": "Not using %>% operator = 5 points deduction", "poor_comments": "Insufficient comments = 3 points deduction", "messy_code": "Poor formatting = 2 points deduction"}}, "business_understanding": {"weight": 0.2, "max_points": 20, "description": "Demonstrates understanding of business context and data analysis", "criteria": ["Appropriate handling of missing values", "Correct interpretation of outliers", "Meaningful grouping and aggregation", "Business-relevant insights", "Proper data cleaning decisions"]}, "analysis_insights": {"weight": 0.15, "max_points": 15, "description": "Meaningful insights and recommendations from analysis", "criteria": ["Identifies key patterns in data", "Draws actionable conclusions", "Supports insights with data", "Considers business implications"]}, "reflection_questions": {"weight": 0.05, "max_points": 5, "description": "Thoughtful answers to reflection questions", "questions": {"question_9_1": {"points": 1, "description": "Data cleaning impact"}, "question_9_2": {"points": 1, "description": "Grouped analysis value"}, "question_9_3": {"points": 1, "description": "Data reshaping purpose"}, "question_9_4": {"points": 1, "description": "Joining datasets"}, "question_9_5": {"points": 1, "description": "Skills integration"}}}}, "autograder_checks": {"required_variables": ["sales_data", "customers", "products", "orders", "order_items", "sales_clean", "missing_summary", "outlier_analysis", "sales_summary", "high_revenue_sales", "top_sales", "regional_top_sales", "sales_enhanced", "overall_summary", "regional_summary", "category_summary", "region_category_revenue", "revenue_wide", "revenue_long", "customer_orders", "orders_with_items", "business_kpis"], "sections": {"part1_setup": {"name": "Part 1: R Basics and Data Import (Lesson 1)", "points": 10, "variables": ["sales_data", "customers", "products", "orders", "order_items"], "functions": ["setwd", "library", "read_csv"], "expected_data": {"sales_data_rows": 500, "customers_rows": 100, "products_rows": 50, "orders_rows": 200, "order_items_rows": 500}, "validation": {"check_working_directory": true, "check_packages_loaded": ["tidyverse", "lubridate"], "check_data_imported": true}}, "part2_data_cleaning": {"name": "Part 2: Data Cleaning - Missing Values & Outliers (Lesson 2)", "points": 15, "variables": ["missing_summary", "sales_clean", "outlier_analysis"], "functions": ["is.na", "colSums", "na.omit", "quantile"], "required_columns": ["Q1", "Q3", "IQR", "lower_bound", "upper_bound"], "validation": {"check_missing_handled": true, "check_outlier_detection": true, "iqr_method_used": true}}, "part3_transformation_1": {"name": "Part 3: Data Transformation Part 1 (Lesson 3)", "points": 10, "variables": ["sales_summary", "high_revenue_sales", "top_sales", "regional_top_sales"], "functions": ["select", "filter", "arrange", "%>%"], "validation": {"pipe_operator_used": true, "correct_filtering": true, "correct_sorting": true, "chained_operations": true}}, "part4_transformation_2": {"name": "Part 4: Data Transformation Part 2 (Lesson 4)", "points": 15, "variables": ["sales_enhanced", "overall_summary", "regional_summary", "category_summary"], "functions": ["mutate", "summarize", "group_by"], "required_columns": ["revenue_per_unit", "high_value", "total_revenue", "avg_revenue", "transaction_count"], "validation": {"mutate_creates_columns": true, "summarize_calculates_metrics": true, "group_by_used_correctly": true}}, "part5_reshaping": {"name": "Part 5: Data Reshaping with tidyr (Lesson 5)", "points": 10, "variables": ["region_category_revenue", "revenue_wide", "revenue_long"], "functions": ["pivot_wider", "pivot_longer"], "validation": {"wide_format_correct": true, "long_format_correct": true, "data_preserved": true}}, "part6_joins": {"name": "Part 6: Combining Datasets with Joins (Lesson 6)", "points": 10, "variables": ["customer_orders", "orders_with_items"], "functions": ["left_join", "inner_join"], "validation": {"left_join_correct": true, "inner_join_correct": true, "join_keys_correct": true}}, "part7_strings_dates": {"name": "Part 7: String Manipulation & Date/Time Operations (Lesson 7)", "points": 15, "variables": ["sales_enhanced"], "functions": ["str_trim", "str_to_title", "mdy", "month", "wday"], "required_columns": ["region_clean", "category_clean", "date_parsed", "sale_month", "sale_weekday"], "validation": {"string_cleaning_correct": true, "date_parsing_correct": true, "date_components_extracted": true}}, "part8_advanced": {"name": "Part 8: Advanced Wrangling & Business Intelligence (Lesson 8)", "points": 10, "variables": ["sales_enhanced", "business_kpis"], "functions": ["case_when"], "required_columns": ["performance_tier", "total_revenue", "total_transactions", "avg_transaction_value", "high_value_pct"], "validation": {"case_when_used": true, "kpis_calculated": true, "business_logic_correct": true}}, "part9_reflections": {"name": "Part 9: Reflection Questions", "points": 5, "reflection_questions": 5, "check_type": "markdown", "min_words_per_question": 30}}}, "grading_guidelines": {"full_credit_criteria": ["All code executes without errors", "All required variables created with correct names", "Proper use of tidyverse functions throughout", "Pipe operator used consistently", "All reflection questions answered thoughtfully", "Code is well-commented and readable"], "partial_credit_scenarios": {"minor_syntax_errors": "If code has minor errors but logic is correct, give 80% credit", "missing_comments": "If code works but lacks comments, give 90% credit", "inefficient_approach": "If code works but uses inefficient method, give 85% credit"}, "zero_credit_scenarios": ["Code not executed (no outputs)", "Only template code with TODOs", "Critical errors preventing any analysis", "Wrong data files used", "Plagiarism or academic dishonesty"]}, "common_issues_and_solutions": {"issue_1_working_directory": {"problem": "Working directory not set correctly", "correct_solution": "Use setwd() with full path to data folder", "note": "Students must set their own path"}, "issue_2_missing_values": {"problem": "Not handling missing values", "correct_solution": "Use na.omit() or complete.cases()", "note": "Must remove rows with ANY missing values"}, "issue_3_outlier_detection": {"problem": "Incorrect outlier calculation", "correct_solution": "Use IQR method: Q1 - 1.5*IQR and Q3 + 1.5*IQR", "note": "Must use quantile() function"}, "issue_4_pipe_operator": {"problem": "Not using pipe operator", "correct_solution": "Chain operations with %>%", "note": "Pipe operator is required throughout"}, "issue_5_variable_names": {"problem": "Using wrong variable names", "correct_solution": "Use exact variable names from template", "note": "Variable names must match exactly for autograder"}}, "lesson_coverage": {"lesson_1": {"topics": ["Working directory", "Package loading", "Data import", "Data types"], "points": 10, "sections": ["part1_setup"]}, "lesson_2": {"topics": ["Missing values", "Outlier detection", "Data cleaning"], "points": 15, "sections": ["part2_data_cleaning"]}, "lesson_3": {"topics": ["select()", "filter()", "arrange()", "Pipe operator"], "points": 10, "sections": ["part3_transformation_1"]}, "lesson_4": {"topics": ["mutate()", "summarize()", "group_by()"], "points": 15, "sections": ["part4_transformation_2"]}, "lesson_5": {"topics": ["pivot_wider()", "pivot_longer()", "Tidy data"], "points": 10, "sections": ["part5_reshaping"]}, "lesson_6": {"topics": ["left_join()", "inner_join()", "Data integration"], "points": 10, "sections": ["part6_joins"]}, "lesson_7": {"topics": ["String manipulation", "Date parsing", "lubridate"], "points": 15, "sections": ["part7_strings_dates"]}, "lesson_8": {"topics": ["case_when()", "KPIs", "Business intelligence"], "points": 10, "sections": ["part8_advanced"]}}}