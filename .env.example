# ---- Required ----
SECRET_KEY=change-me-to-random-string
JWT_SECRET_KEY=change-me-to-random-string

# ---- PostgreSQL ----
POSTGRES_USER=grader
POSTGRES_PASSWORD=grader
POSTGRES_DB=ai_homework_grader

# ---- Celery / Redis ----
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0

# ---- CORS (comma-separated origins) ----
CORS_ORIGINS=http://localhost

# ---- File storage ----
STORAGE_ROOT=/app/storage

# ---- vLLM endpoints (auto-resolved via Docker service names) ----
VLLM_QWEN_URL=http://vllm-qwen:8000
VLLM_GPTOSS_URL=http://vllm-gptoss:8001

# ---- Hugging Face (required for downloading models on first run) ----
HF_TOKEN=

# ---- Scaling ----
GUNICORN_WORKERS=4
CELERY_CONCURRENCY=2
HTTP_PORT=80
BACKEND_PORT=5001
